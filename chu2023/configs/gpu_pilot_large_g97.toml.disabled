# Disabled by filename, include_g97, and the required --enable-g97 CLI switch.
[environment]
allocator_policy = "fraction"
memory_fraction = 0.85

[model]
alpha = 0.4
tau = 1.3
state_probabilities = [0.5, 0.5]

[initial_condition]
histogram_seed = 20230818
samples_per_grid_cell = 10

[case]
stage = "large-pilot"
grids = [65, 97]
dtype = "float32"
steps = 1
source_times = [0, 1]
row_block_size = 256
column_block_size = 256
diagnostic_tolerance = 0.0001
symmetry_tolerance = 0.0001
include_g97 = true

[budget]
hourly_price_usd = 0.0
max_session_cost_usd = 200.0
max_stage_seconds = 5400
safety_margin_fraction = 0.35

[output]
run_name = "gpu-pilot-large-g97"
